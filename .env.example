# SAI Library (production – required in production)
SAI_API_KEY=
SAI_BASE_URL=https://api.sai.stefanini.com/v1
SAI_MODEL=auto
SAI_TIMEOUT=120

# OpenAI-compatible fallback (local development only – NOT for production)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Server
DEBUG=false
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# Frontend
BACKEND_URL=http://localhost:8000
